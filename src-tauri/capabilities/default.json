{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the main window's file-picker, update, process-restart, and drag-and-drop event permissions.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
